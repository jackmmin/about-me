# 로컬 개발용: 이 파일을 .env.local로 복사한 뒤 값을 채운다. (.env.local은 커밋되지 않음)
# Supabase 대시보드 > Project Settings > API 에서 확인
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon(public) 키 또는 publishable 키. RLS로 보호되므로 프론트에 노출돼도 된다.
# service_role / secret 키는 절대 넣지 말 것.
VITE_SUPABASE_ANON_KEY=
# 사진 저장용 Cloudflare Worker 주소 (worker/ 배포 후 나오는 주소). 비워 두면 새 사진도 Supabase Storage에 저장
VITE_IMAGE_API_URL=
